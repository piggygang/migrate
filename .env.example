# Which Solana cluster this build talks to: "devnet" (default) or
# "mainnet-beta". Unset means devnet — transactions there cost nothing, so a
# missing variable can never accidentally point a build at real funds. Vercel
# previews stay on devnet; production sets mainnet-beta explicitly.
NEXT_PUBLIC_SOLANA_CLUSTER=

# The Solana RPC the browser calls for blockhashes and confirmations. Optional
# on devnet, where the public endpoint is the default. Required on mainnet-beta:
# no mainnet endpoint ships in this repo, so a build without one fails. Being
# NEXT_PUBLIC_ it is readable by anyone who views source, which is inherent to
# calling an RPC from the browser: rate-limit and domain-restrict it at the
# provider. Holders can override it with their own endpoint from the wallet
# modal.
NEXT_PUBLIC_SOLANA_RPC_URL=

# Base URL of the Piggy Gang metadata JSON, read on the server only. Unset means
# https://assets.piggygang.net/piggy-gang/json/. Every swap writes a URI built
# from this on chain, so only point it elsewhere for a devnet rehearsal.
METADATA_BASE_URL=
